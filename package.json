{
  "name": "@alpha018/nestjs-redisom",
  "version": "1.1.1",
  "description": "A NestJS module for RedisOM, providing a structured way to use Redis Stack JSON/Search features.",
  "author": "Tomás Alegre <tomas.sa467@gmail.com>",
  "readmeFilename": "README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alpha018/nestjs-redisom"
  },
  "keywords": [
    "nestjs",
    "redis",
    "redis-om",
    "redis-stack",
    "database",
    "nosql"
  ],
  "main": "dist/index.js",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist/**/*",
    "*.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/Alpha018/nestjs-redisom/issues"
  },
  "homepage": "https://github.com/Alpha018/nestjs-redisom#readme",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/index",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "REDIS_USE_CLUSTER=false NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json --runInBand",
    "test:e2e:cluster": "REDIS_USE_CLUSTER=true NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json --runInBand",
    "test:all": "NODE_OPTIONS=--experimental-vm-modules jest && REDIS_USE_CLUSTER=false NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json --runInBand && REDIS_USE_CLUSTER=true NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json --runInBand",
    "prepare": "husky || exit 0"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "redis": "^6.3.0",
    "redis-om": "^0.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.20",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-mock-extended": "^4.0.2",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "uuid": "^11.1.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.jest.json",
          "useESM": true
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "/node_modules/(?!@nestjs)"
    ],
    "extensionsToTreatAsEsm": [
      ".ts"
    ]
  }
}
